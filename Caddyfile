your-domain.com {

    # HTTPS 证书自动申请和续期（Let's Encrypt），完全不用管
    # Caddy 是目前唯一默认自动 HTTPS 的反向代理，这是它最大的卖点

    # 反向代理：所有 /api/* 请求转发给 Gunicorn
    reverse_proxy /api/* 127.0.0.1:8000 {

        # SSE 专项配置：关闭响应缓冲
        # 不加这个，Caddy 会把流式响应攒够再发，SSE 效果消失
        flush_interval -1
        # -1 的意思是"收到数据立刻 flush"

        # 把真实客户端 IP 传给后端（否则后端只能看到 127.0.0.1）
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}#只能写一个单一的 IP（例如 123.45.67.89）
        # 简单的“用户 -> 你的网关 -> 后端”结构

        header_up X-Forwarded-Proto {scheme}#可以是一个IP 链（例如 用户IP, CDN_IP, 代理IP）
        # 复杂的“用户 -> CDN -> 负载均衡 -> 网关 -> 后端”结构    
        # 发送 X-Forwarded-Proto 标签，内容是 {scheme}（用户访问的协议，比如 http 或 https）
    }

    # 日志
    log {
        output file /var/log/caddy/evan.log
        format json
    }
}

# HTTP 自动重定向到 HTTPS（Caddy 默认就做，这里显式写出来方便理解）
http://your-domain.com {
    redir https://your-domain.com{uri} permanent
}